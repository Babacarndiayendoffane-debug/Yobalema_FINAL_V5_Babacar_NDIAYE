        "--web-port=3000",
        "--web-hostname=127.0.0.1"
      ]
    },
    {
      "name": "Yobalema Driver (Edge)",
      "program": "lib/main_driver.dart",
      "request": "launch",
      "type": "dart",
      "deviceId": "edge",
      "args": [
